{
  "name": "poc",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,vue}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" --fix",
    "format": "prettier --check \"src/**/*.{ts,vue,js,json,css,scss,html,md}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,vue,js,json,css,scss,html,md}\"",
    "lint:format": "bun run lint && bun run format",
    "lint:format:fix": "bun run lint:fix && bun run format:fix",
    "worker:dev": "wrangler dev src/limoResolver.ts",
    "worker:deploy": "wrangler deploy src/limoResolver.ts"
  },
  "dependencies": {
    "ethers": "^6.13.4",
    "ethereum-blockies-base64": "^1.0.2",
    "multiformats": "^13.4.1",
    "pinia": "^2.1.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "viem": "^2.21.54",
    "vue": "^3.5.22",
    "vue-router": "^4.0.3",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251111.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/cli-plugin-router": "~5.0.9",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.5.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "rollup": "^4.52.5",
    "tailwindcss": "^4.1.16",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vue-cli-plugin-pinia": "~0.2.4",
    "vue-tsc": "^3.1.0",
    "wrangler": "^4.47.0"
  },
  "type": "module"
}
